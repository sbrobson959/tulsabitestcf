{
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "geolocation=(), microphone=(), camera=()"
				}
			]
		}
	],
	"crons": [
		{
			"path": "/api/update",
			"schedule": "0 13 * * 1"
		}
	],
	"functions": {
		"api/update.ts": {
			"maxDuration": 300
		}
	}
}
